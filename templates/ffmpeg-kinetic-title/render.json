{
  "command": [
    "ffmpeg",
    "-y",
    "-f",
    "lavfi",
    "-i",
    "color=c=0x070b12:s={{width}}x{{height}}:r={{fps}}:d={{duration}}",
    "-f",
    "lavfi",
    "-i",
    "aevalsrc=0.06*sin(2*PI*110*t)+0.03*sin(2*PI*220*t):d={{duration}}",
    "-filter_complex",
    "[0:v]drawgrid=w=64:h=64:t=1:c=0x101a29[bg];[bg]drawbox=x=in_w*0.1:y=in_h*0.45:w=in_w*0.8:h=2:color=0x8b5cf6@0.8:t=fill[line];[line]drawtext=text='VIDEUR':fontcolor=white:fontsize=96:x='(w-text_w)/2+80*exp(-3*t)':y=h*0.36:alpha='1-exp(-4*t)',drawtext=text='ESTUDIO DE VIDEO PROGRAMATICO':fontcolor=0x22d3ee:fontsize=28:x=(w-text_w)/2:y=h*0.52:alpha='(t-1.6)/0.6',drawtext=text='FFmpeg · Manim · Remotion':fontcolor=0x8fa3ba:fontsize=22:x=(w-text_w)/2:y=h*0.6:alpha='(t-2.0)/0.6',fade=t=in:st=0:d=0.4,fade=t=out:st={{fadeOutStart}}:d=0.6[v]",
    "-map",
    "[v]",
    "-map",
    "1:a",
    "-c:v",
    "libx264",
    "-pix_fmt",
    "yuv420p",
    "-preset",
    "fast",
    "-crf",
    "18",
    "-c:a",
    "aac",
    "-b:a",
    "192k",
    "-movflags",
    "+faststart",
    "{{output}}"
  ]
}
