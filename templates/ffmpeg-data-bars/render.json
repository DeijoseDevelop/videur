{
  "command": [
    "ffmpeg",
    "-y",
    "-f",
    "lavfi",
    "-i",
    "color=c=0x070b12:s={{width}}x{{height}}:r={{fps}}:d={{duration}}",
    "-f",
    "lavfi",
    "-i",
    "aevalsrc=0.08*sin(2*PI*220*t)+0.04*sin(2*PI*330*t):d={{duration}}",
    "-filter_complex",
    "[0:v]drawgrid=w=80:h=80:t=1:c=0x142033[bg];[bg]drawbox=x=in_w*0.28:y=in_h*0.8333-in_h*0.1667*abs(sin(t*1.2+0)):w=in_w*0.0625:h=in_h*0.1667:color=0x22d3ee@0.9:t=fill[b1];[b1]drawbox=x=in_w*0.3738:y=in_h*0.8333-in_h*0.25*abs(sin(t*0.9+0.6)):w=in_w*0.0625:h=in_h*0.25:color=0x8b5cf6@0.9:t=fill[b2];[b2]drawbox=x=in_w*0.4675:y=in_h*0.8333-in_h*0.2083*abs(sin(t*1.4+1.2)):w=in_w*0.0625:h=in_h*0.2083:color=0xf59e0b@0.9:t=fill[b3];[b3]drawbox=x=in_w*0.5613:y=in_h*0.8333-in_h*0.2917*abs(sin(t*0.8+1.8)):w=in_w*0.0625:h=in_h*0.2917:color=0x34d399@0.9:t=fill[b4];[b4]drawbox=x=in_w*0.655:y=in_h*0.8333-in_h*0.2222*abs(sin(t*1.1+2.4)):w=in_w*0.0625:h=in_h*0.2222:color=0x22d3ee@0.9:t=fill[b5];[b5]drawtext=text='ENERGIA SOLAR':fontcolor=white:fontsize=56:x=(w-text_w)/2:y=h*0.12,drawtext=text='Datos animados con FFmpeg':fontcolor=0x8fa3ba:fontsize=28:x=(w-text_w)/2:y=h*0.22,fade=t=in:st=0:d=0.6,fade=t=out:st={{fadeOutStart}}:d=0.6[v]",
    "-map",
    "[v]",
    "-map",
    "1:a",
    "-c:v",
    "libx264",
    "-pix_fmt",
    "yuv420p",
    "-preset",
    "fast",
    "-crf",
    "18",
    "-c:a",
    "aac",
    "-b:a",
    "192k",
    "-movflags",
    "+faststart",
    "{{output}}"
  ]
}
