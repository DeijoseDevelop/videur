{
  "command": [
    "ffmpeg",
    "-y",
    "-f",
    "lavfi",
    "-i",
    "color=c=0x070b12:s={{width}}x{{height}}:r={{fps}}:d={{duration}}",
    "-f",
    "lavfi",
    "-i",
    "aevalsrc=0.08*sin(2*PI*220*t)+0.04*sin(2*PI*330*t):d={{duration}}",
    "-f",
    "lavfi",
    "-i",
    "color=c=0x22d3ee:s=2x2:r={{fps}}:d={{duration}}",
    "-f",
    "lavfi",
    "-i",
    "color=c=0x8b5cf6:s=2x2:r={{fps}}:d={{duration}}",
    "-f",
    "lavfi",
    "-i",
    "color=c=0xf59e0b:s=2x2:r={{fps}}:d={{duration}}",
    "-f",
    "lavfi",
    "-i",
    "color=c=0x34d399:s=2x2:r={{fps}}:d={{duration}}",
    "-f",
    "lavfi",
    "-i",
    "color=c=0x22d3ee:s=2x2:r={{fps}}:d={{duration}}",
    "-f",
    "lavfi",
    "-i",
    "color=c=0x22d3ee@0.18:s=2x2:r={{fps}}:d={{duration}}",
    "-filter_complex",
    "[0:v]drawgrid=w=80:h=80:t=1:c=0x142033[bg];[2:v]scale=w={{width}}*0.0625:h={{height}}*0.1667[bar1];[3:v]scale=w={{width}}*0.0625:h={{height}}*0.25[bar2];[4:v]scale=w={{width}}*0.0625:h={{height}}*0.2083[bar3];[5:v]scale=w={{width}}*0.0625:h={{height}}*0.2917[bar4];[6:v]scale=w={{width}}*0.0625:h={{height}}*0.2222[bar5];[7:v]scale=2:{{height}}*0.75[scanline];[bg][bar1]overlay=x=main_w*0.28:y=main_h*0.8333-overlay_h-main_h*0.10*abs(sin(t*1.8)):eval=frame[b1];[b1][bar2]overlay=x=main_w*0.3738:y=main_h*0.8333-overlay_h-main_h*0.08*abs(sin(t*1.3+0.6)):eval=frame[b2];[b2][bar3]overlay=x=main_w*0.4675:y=main_h*0.8333-overlay_h-main_h*0.09*abs(sin(t*2.1+1.2)):eval=frame[b3];[b3][bar4]overlay=x=main_w*0.5613:y=main_h*0.8333-overlay_h-main_h*0.07*abs(sin(t*1.1+1.8)):eval=frame[b4];[b4][bar5]overlay=x=main_w*0.655:y=main_h*0.8333-overlay_h-main_h*0.11*abs(sin(t*1.6+2.4)):eval=frame[b5];[b5][scanline]overlay=x=main_w*0.1+main_w*0.8*(t/{{duration}}):y=main_h*0.08:eval=frame[scan];[scan]drawbox=x=in_w*0.1:y=in_h*0.8333:w=in_w*0.8:h=2:color=0x22d3ee@0.4:t=fill,drawtext=text='ENERGIA SOLAR':fontcolor=white:fontsize=56:x=(w-text_w)/2+20*sin(t*0.8):y=h*0.12:alpha=1-exp(-2.2*t),drawtext=text='Datos animados con FFmpeg':fontcolor=0x8fa3ba:fontsize=28:x=(w-text_w)/2:y=h*0.22:alpha=1-exp(-1.8*(t-0.3)),fade=t=in:st=0:d=0.5,fade=t=out:st={{fadeOutStart}}:d=0.6[v]",
    "-map",
    "[v]",
    "-map",
    "1:a",
    "-c:v",
    "libx264",
    "-pix_fmt",
    "yuv420p",
    "-preset",
    "fast",
    "-crf",
    "18",
    "-c:a",
    "aac",
    "-b:a",
    "192k",
    "-movflags",
    "+faststart",
    "{{output}}"
  ]
}
