# ── Servidor ────────────────────────────────────────────────────────────────
VIDEUR_HOST=127.0.0.1
VIDEUR_PORT=8787
VIDEUR_DATA_DIR=./data
VIDEUR_TEMPLATES_DIR=./templates
VIDEUR_WEB_DIST=./apps/web/dist
VIDEUR_LOG_LEVEL=info

# Token opcional. Si se define, la API exige Authorization: Bearer <token>.
VIDEUR_API_TOKEN=

# ── Render ──────────────────────────────────────────────────────────────────
VIDEUR_MAX_CONCURRENT_RENDERS=1
VIDEUR_RENDER_TIMEOUT_MS=600000
VIDEUR_MAX_LOG_BYTES=2000000
# trusted = ejecuta código en la máquina; docker = recomienda aislamiento.
VIDEUR_SANDBOX_MODE=trusted
# Permite render.sh además de render.json en el motor FFmpeg.
VIDEUR_ALLOW_SHELL_SCRIPTS=false

# ── Agente ──────────────────────────────────────────────────────────────────
VIDEUR_AGENT_MAX_ITERATIONS=30
VIDEUR_AGENT_TIMEOUT_MS=900000
VIDEUR_AGENT_MAX_TOKENS=8192

# ── Proveedores (opcionales; también se configuran desde la UI) ─────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
LMSTUDIO_BASE_URL=http://127.0.0.1:1234

# ── Herramientas externas (opcional) ────────────────────────────────────────
# Ruta al binario de ffmpeg/ffprobe si no están en PATH.
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
# MANIM_PATH=/usr/local/bin/manim
# PYTHON_PATH=/usr/bin/python3
